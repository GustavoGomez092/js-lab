{
  "name": "JSLab Test Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#24292F",
    "foreground": "#1F2328",
    "sideBar.background": "#F6F8FA",
    "activityBar.background": "#F6F8FA",
    "statusBar.background": "#F6F8FA",
    "editorWidget.background": "#FFFFFF",
    "dropdown.background": "#FFFFFF",
    "menu.background": "#FFFFFF",
    "panel.border": "#D0D7DE",
    "editorGroup.border": "#D0D7DE",
    "contrastBorder": "#D0D7DE",
    "widget.border": "#D0D7DE",
    "descriptionForeground": "#656D76",
    "editorLineNumber.foreground": "#8C959F",
    "focusBorder": "#0969DA",
    "textLink.foreground": "#0969DA",
    "button.background": "#1F883D",
    "progressBar.background": "#0969DA",
    "errorForeground": "#CF222E",
    "editorError.foreground": "#CF222E",
    "list.errorForeground": "#CF222E",
    "editorWarning.foreground": "#9A6700",
    "list.warningForeground": "#9A6700",
    "editorInfo.foreground": "#0969DA",
    "textLink.activeForeground": "#0550AE",
    "gitDecoration.addedResourceForeground": "#1A7F37",
    "terminal.ansiGreen": "#1A7F37",
    "editor.selectionBackground": "#B6E3FF",
    "selection.background": "#B6E3FF",
    "editor.lineHighlightBackground": "#F6F8FA"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6E7781", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#0A3069" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#0550AE" } },
    { "scope": "keyword", "settings": { "foreground": "#CF222E" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#8250DF" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#953800" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#116329" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#0550AE" } },
    { "scope": "punctuation", "settings": { "foreground": "#24292F" } },
    { "scope": "variable", "settings": { "foreground": "#953800" } }
  ]
}
