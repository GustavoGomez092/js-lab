{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/artifacts",
      "!**/.hutch",
      "!**/.cottontail-tmp",
      "!spikes",
      "!packages/runner-web/src/polyfills/vendor/*.js"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noJsxLiterals": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/isolated/**"],
      "linter": { "rules": { "style": { "noJsxLiterals": "off" } } }
    },
    {
      "includes": [
        "apps/ui/src/env/EnvVarsSheet.tsx",
        "apps/ui/src/npm/NpmSheet.tsx",
        "apps/ui/src/output/EntryRow.tsx",
        "apps/ui/src/output/ValueView.tsx",
        "apps/ui/src/shell/StatusBar.tsx",
        "apps/ui/src/shell/Toolbar.tsx",
        "apps/ui/src/shell/parts.tsx",
        "apps/ui/src/tabs/TabBar.tsx"
      ],
      "linter": { "rules": { "style": { "noJsxLiterals": "off" } } }
    }
  ]
}
