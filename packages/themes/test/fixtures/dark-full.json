{
  "name": "JSLab Test Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1E2127",
    "editor.foreground": "#D7DAE0",
    "foreground": "#C8CCD4",
    "sideBar.background": "#181B20",
    "activityBar.background": "#14171B",
    "statusBar.background": "#1E2127",
    "editorWidget.background": "#23272E",
    "dropdown.background": "#23272E",
    "menu.background": "#23272E",
    "panel.border": "#3B4048",
    "editorGroup.border": "#3B4048",
    "contrastBorder": "#3B4048",
    "widget.border": "#3B4048",
    "descriptionForeground": "#9DA5B4",
    "editorLineNumber.foreground": "#636D83",
    "focusBorder": "#61AFEF",
    "textLink.foreground": "#61AFEF",
    "button.background": "#3B84D8",
    "progressBar.background": "#61AFEF",
    "errorForeground": "#E06C75",
    "editorError.foreground": "#E06C75",
    "list.errorForeground": "#E06C75",
    "editorWarning.foreground": "#E5C07B",
    "list.warningForeground": "#E5C07B",
    "editorInfo.foreground": "#56B6C2",
    "textLink.activeForeground": "#56B6C2",
    "gitDecoration.addedResourceForeground": "#98C379",
    "terminal.ansiGreen": "#98C379",
    "editor.selectionBackground": "#3E4451",
    "selection.background": "#3E4451",
    "editor.lineHighlightBackground": "#2C313A",
    "editorCursor.foreground": "#528BFF",
    "titleBar.activeBackground": "#1E2127"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#7F848E", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#98C379" } },
    { "scope": "string.regexp", "settings": { "foreground": "#56B6C2" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#56B6C2" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#D19A66" } },
    { "scope": "keyword", "settings": { "foreground": "#C678DD" } },
    { "scope": "storage.type", "settings": { "foreground": "#C678DD" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#61AFEF" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#E5C07B" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#E06C75" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#D19A66" } },
    { "scope": "punctuation", "settings": { "foreground": "#ABB2BF" } },
    { "scope": "variable", "settings": { "foreground": "#D7DAE0" } }
  ]
}
