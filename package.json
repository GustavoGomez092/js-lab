{
  "name": "jslab",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "i18n:check": "bun run --cwd apps/ui i18n:check",
    "e2e": "bun run --cwd packages/e2e e2e",
    "e2e:npm": "bun run --cwd packages/e2e e2e:npm",
    "test:npm": "bun run --cwd packages/test-registry test:npm && bun run --cwd apps/desktop test:npm",
    "readme:screenshots": "bun packages/e2e/scripts/readme-screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
